---
interface Props { lang: 'zh' | 'en' }
const { lang } = Astro.props;
const zh = lang === 'zh';
const base = import.meta.env.BASE_URL;
const home = zh ? base : `${base}en/`;

const stats = zh ? [
  ['33', 'do.* 工作流技能'],
  ['11', '语义化目录'],
  ['5', 'Agent 运行时'],
  ['0', '云端账号'],
] : [
  ['33', 'do.* workflow skills'],
  ['11', 'semantic directories'],
  ['5', 'agent runtimes'],
  ['0', 'cloud accounts'],
];

type DirMeta = {
  lane: number;
  logical: string;
  path: string;
  zh: { title: string; summary: string; when_not: string; ai_notes: string };
  en: { title: string; summary: string; when_not: string; ai_notes: string };
};

const DIRS: DirMeta[] = [
  {
    lane: 0, logical: 'inbox', path: '00_Inbox',
    zh: {
      title: '快速捕获',
      summary: '未经分类的想法、临时任务、待整理的剪藏；默认 Todos.md 也在这里。',
      when_not: '已经明确归属的内容直接放到对应目录，不要先进 Inbox 再搬一次。',
      ai_notes: '添加任务用 deeporbit todo add，不手改 Todos.md；整理用 deeporbit triage，不手移文件。',
    },
    en: {
      title: 'Quick capture',
      summary: 'Unfiled ideas, ad-hoc tasks, clipped references; the default Todos.md also lives here.',
      when_not: 'If a piece of content already has a clear home, put it there directly — do not route it through Inbox first.',
      ai_notes: 'Add tasks with deeporbit todo add instead of editing Todos.md by hand; triage with deeporbit triage instead of moving files manually.',
    },
  },
  {
    lane: 1, logical: 'diary', path: '10_Diary',
    zh: {
      title: '日志',
      summary: 'Daily Notes 与短期上下文，按日期一篇一个文件。',
      when_not: '持续性主题（项目、研究、概念）不放日记，放各自目录。',
      ai_notes: '通过 deeporbit calendar / deeporbit agenda 查询；写新日记用对应技能而不是手建文件。',
    },
    en: {
      title: 'Diary',
      summary: 'Daily notes and short-lived context, one file per date.',
      when_not: 'Long-running topics (projects, research, concepts) do not belong here — they go to their own directories.',
      ai_notes: 'Query through deeporbit calendar / deeporbit agenda; create new entries via the matching skill, not by hand-making files.',
    },
  },
  {
    lane: 1, logical: 'writings', path: '15_Writings',
    zh: {
      title: '写作',
      summary: '用户亲笔写的内容：随笔、文章、书稿。',
      when_not: 'AI 生成的草稿放 60_Notes，确认采用后才挪到这里。',
      ai_notes: '写入前必须先读现有同主题文章，避免覆盖用户文字。',
    },
    en: {
      title: 'Writings',
      summary: 'Pieces the user wrote by hand: essays, articles, book drafts.',
      when_not: 'AI-generated drafts go to 60_Notes; only move them here once the user adopts them.',
      ai_notes: 'Read any existing piece on the same topic before writing — never overwrite the user\'s words.',
    },
  },
  {
    lane: 1, logical: 'family', path: '70_Family',
    zh: {
      title: '家庭',
      summary: '家庭与个人生活记录。',
      when_not: '工作相关的内容放对应工作目录。',
      ai_notes: '默认隐私等级最高；privacy 扫描默认覆盖。',
    },
    en: {
      title: 'Family',
      summary: 'Family and personal-life records.',
      when_not: 'Work-related content goes to the matching work directory.',
      ai_notes: 'Highest default privacy level; covered by the default privacy scan.',
    },
  },
  {
    lane: 2, logical: 'projects', path: '20_Projects',
    zh: {
      title: '项目',
      summary: '有明确目标与结束条件的工作；status 字段驱动生命周期。',
      when_not: '长期兴趣、没有结束条件的主题放 30_Research。',
      ai_notes: '状态迁移走 deeporbit pause/resume/done/archive；不要手改 frontmatter status。',
    },
    en: {
      title: 'Projects',
      summary: 'Work with a clear goal and a finish condition; the status field drives the lifecycle.',
      when_not: 'Open-ended interests without an end condition go to 30_Research.',
      ai_notes: 'Run state transitions through deeporbit pause/resume/done/archive — never hand-edit the frontmatter status.',
    },
  },
  {
    lane: 2, logical: 'plans', path: '90_Plans',
    zh: {
      title: '计划',
      summary: '可评审的执行计划与检查点。',
      when_not: '长期目标放 projects；一次性 todo 放 inbox。',
      ai_notes: '计划文件用 deeporbit 模板生成，不手写。',
    },
    en: {
      title: 'Plans',
      summary: 'Reviewable execution plans and checkpoints.',
      when_not: 'Long-term goals live in projects; one-off todos live in inbox.',
      ai_notes: 'Generate plan files from deeporbit templates — do not hand-write them.',
    },
  },
  {
    lane: 3, logical: 'research', path: '30_Research',
    zh: {
      title: '研究',
      summary: '开放性的探索与调研，可能没有结论。',
      when_not: '有交付物的具体工作放 20_Projects。',
      ai_notes: '同 projects，状态迁移走 CLI。',
    },
    en: {
      title: 'Research',
      summary: 'Open-ended exploration and investigation; it may never reach a conclusion.',
      when_not: 'Concrete work with a deliverable goes to 20_Projects.',
      ai_notes: 'Same as projects: state transitions go through the CLI.',
    },
  },
  {
    lane: 3, logical: 'wiki', path: '40_Wiki',
    zh: {
      title: 'Wiki',
      summary: '原子、可复用的概念笔记；Zettelkasten 风格。',
      when_not: '一次性总结、原始剪藏放 60_Notes。',
      ai_notes: '新增条目用 wikilink 串联，不复制粘贴现有内容。',
    },
    en: {
      title: 'Wiki',
      summary: 'Atomic, reusable concept notes in Zettelkasten style.',
      when_not: 'One-off summaries and raw clippings go to 60_Notes.',
      ai_notes: 'Link new entries with wikilinks; do not copy-paste existing content.',
    },
  },
  {
    lane: 3, logical: 'resources', path: '50_Resources',
    zh: {
      title: '资源',
      summary: '策展的外部资料：工具、书籍、链接。',
      when_not: '自己的笔记不放这里。',
      ai_notes: '附来源 URL 与获取日期。',
    },
    en: {
      title: 'Resources',
      summary: 'Curated external material: tools, books, links.',
      when_not: 'Your own notes do not live here.',
      ai_notes: 'Always attach the source URL and the date it was fetched.',
    },
  },
  {
    lane: 3, logical: 'notes', path: '60_Notes',
    zh: {
      title: '笔记',
      summary: '摘要、原始知识捕获、AI 生成草稿。',
      when_not: '定稿的亲笔写作放 15_Writings；概念性内容进 40_Wiki。',
      ai_notes: '外部同步目录（如微信读书）由 deeporbit 标记为 readonly，不要写入。',
    },
    en: {
      title: 'Notes',
      summary: 'Summaries, raw knowledge captures, and AI-generated drafts.',
      when_not: 'Final handwritten pieces go to 15_Writings; conceptual content goes to 40_Wiki.',
      ai_notes: 'External sync targets (e.g. WeRead) are marked readonly by deeporbit — never write into them.',
    },
  },
  {
    lane: 4, logical: 'system', path: '99_System',
    zh: {
      title: '系统',
      summary: 'DeepOrbit 自身的模板、Bases、提示词、规则、归档。',
      when_not: '用户内容永远不要放 99_System。',
      ai_notes: '本目录大部分内容由 deeporbit sync-prompts / init 物化；手写内容放 managed block 之外。',
    },
    en: {
      title: 'System',
      summary: 'DeepOrbit\'s own templates, Bases, prompts, rules, and archives.',
      when_not: 'User content never goes into 99_System.',
      ai_notes: 'Most of this directory is materialized by deeporbit sync-prompts / init; handwritten content goes outside the managed block.',
    },
  },
];

const LANES = {
  zh: ['捕捉', '记录', '推进', '沉淀', '系统'],
  en: ['Capture', 'Record', 'Act', 'Distill', 'System'],
};
const laneNames = zh ? LANES.zh : LANES.en;

const skills = [
  'do.agenda', 'do.agent', 'do.archive', 'do.arxiv-translator', 'do.ask',
  'do.brainstorm', 'do.calendar', 'do.daily', 'do.dream', 'do.fix-links',
  'do.heartbeat', 'do.init', 'do.kickoff', 'do.link', 'do.mentor',
  'do.mermaid', 'do.note-summary', 'do.obsidian-open', 'do.organize', 'do.parse-knowledge',
  'do.pdf-to-markdown', 'do.rag', 'do.rag-index', 'do.recap', 'do.refresh-prompt',
  'do.remind', 'do.research', 'do.search', 'do.teach-me', 'do.todo',
  'do.translate', 'do.translate-markdown', 'do.write',
];

const runtimes = ['Claude Code', 'Codex', 'Gemini', 'OMP', 'OpenClaw'];

const quickstart = zh ? [
  ['安装技能', '把 portable Skills 装进你正在用的 Agent 运行时。', 'npx skills add dull-bird/DeepOrbit'],
  ['初始化 vault', '生成目录模型、模板、Bases 与技能索引；已有笔记原样保留。', 'deeporbit --vault ~/MyVault init'],
  ['打开仪表盘', '本地仪表盘即刻呈现工作状态：active、paused、done、archived。', 'deeporbit --vault ~/MyVault serve --open'],
] : [
  ['Add the skills', 'Install the portable Skills into the agent runtime you already use.', 'npx skills add dull-bird/DeepOrbit'],
  ['Initialize a vault', 'Materializes the directory model, templates, Bases, and skill index — existing notes are preserved.', 'deeporbit --vault ~/MyVault init'],
  ['Open the dashboard', 'A local dashboard shows the state of your work: active, paused, done, archived.', 'deeporbit --vault ~/MyVault serve --open'],
];

const defaultDir = DIRS[0]; // inbox
const defaultCopy = zh ? defaultDir.zh : defaultDir.en;
---

<!-- ============ Hero ============ -->
<section class="hero container">
  <div class="eyebrow">DeepOrbit 2.0 · {zh ? '本地优先的 Agent Skills 套件' : 'Local-first Agent Skills'}</div>
  <h1>{zh ? <>你的任务、项目和知识，<br />应该长成<span class="accent">同一个系统。</span></> : <>Your tasks, projects, and knowledge should grow into <span class="accent">one system.</span></>}</h1>
  <p class="hero-sub">{zh
    ? 'DeepOrbit 把 Obsidian vault 变成任务、项目与知识管理的同一份事实源：33 个可移植技能，跨 5 个 Agent 运行时，AI 通过 deeporbit about 直接读懂每个目录的语义与边界。'
    : 'DeepOrbit turns an Obsidian vault into a single source of truth for tasks, projects, and knowledge: 33 portable skills across 5 agent runtimes. AI reads the semantics and boundaries of every directory through deeporbit about.'}</p>
  <div class="actions">
    <a class="button primary" href={`${home}docs/`}>{zh ? '开始使用' : 'Get started'} <span class="arrow" aria-hidden="true">→</span></a>
    <a class="button" href="https://github.com/dull-bird/DeepOrbit">GitHub</a>
  </div>
</section>

<section class="stats container" aria-label={zh ? '关键数字' : 'Key numbers'}>
  {stats.map(([num, label]) => (
    <div class="stat"><span class="stat-num">{num}</span><span class="stat-label">{label}</span></div>
  ))}
</section>

<!-- ============ Vault skeleton ============ -->
<section id="vault" class="container section">
  <div class="section-head">
    <div class="eyebrow">{zh ? 'Vault 骨架' : 'Vault skeleton'}</div>
    <div>
      <h2>{zh ? '5 条轨道，11 个目录。AI 一眼读懂。' : 'Five lanes, eleven directories. AI reads it at a glance.'}</h2>
      <p class="section-intro">{zh ? '悬停任意节点，看 deeporbit about 给 AI 的描述。' : 'Hover any node to see what deeporbit about tells the AI.'}</p>
    </div>
  </div>
  <div class="skeleton-grid">
    <div class="skeleton-lanes">
      {laneNames.map((laneName, i) => (
        <div class="sk-lane" data-lane={i}>
          <div class="sk-lane-name"><span class="sk-lane-dot" data-lane={i}></span>{laneName}</div>
          <div class="sk-lane-track">
            {DIRS.filter((d) => d.lane === i).map((d) => (
              <button
                type="button"
                class:list={['sk-node', d.logical === 'inbox' && 'is-active']}
                data-logical={d.logical}
                data-lane={d.lane}
                aria-label={zh ? d.zh.title : d.en.title}
              >
                <span class="sk-dot" aria-hidden="true"></span>
                <span class="sk-path">{d.path}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
    <aside class="sk-card" aria-live="polite">
      <div class="sk-card-head">
        <code class="sk-card-path" id="sk-path">{defaultDir.path}</code>
        <span class="sk-card-logical" id="sk-logical">{defaultDir.logical}</span>
      </div>
      <h3 id="sk-title">{defaultCopy.title}</h3>
      <dl class="sk-fields">
        <div>
          <dt>{zh ? '装什么' : 'What goes here'}</dt>
          <dd id="sk-summary">{defaultCopy.summary}</dd>
        </div>
        <div>
          <dt>{zh ? '什么时候不放这里' : 'When NOT to use'}</dt>
          <dd id="sk-when-not">{defaultCopy.when_not}</dd>
        </div>
        <div>
          <dt>{zh ? 'AI 使用约定' : 'AI usage'}</dt>
          <dd id="sk-ai-notes">{defaultCopy.ai_notes}</dd>
        </div>
      </dl>
      <div class="sk-actions">
        <button type="button" id="sk-cycle" class="text-btn">{zh ? '换一个' : 'Next'}</button>
        <button
          type="button"
          class="text-btn copy-btn"
          data-copy="deeporbit about"
          aria-label={zh ? '复制 deeporbit about 命令' : 'Copy the deeporbit about command'}
        >
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          <span class="copy-label">{zh ? '复制 deeporbit about' : 'Copy deeporbit about'}</span>
        </button>
      </div>
    </aside>
  </div>
</section>

<!-- ============ Why AI can read this ============ -->
<section class="well">
  <div class="container section ai-grid">
    <div class="ai-copy">
      <div class="eyebrow">{zh ? '机器可读' : 'Machine-readable'}</div>
      <h2>{zh ? '以前 AI 靠猜，现在它能问。' : 'AI used to guess. Now it can ask.'}</h2>
      <p>{zh
        ? '打开一个 vault，AI 看到的是一堆文件夹名字。00_Inbox 是收件箱吗？30_Research 和 40_Wiki 有什么差别？以前它只能猜——猜错了就把笔记放错地方。'
        : 'When AI opens a vault, all it sees is a pile of folder names. Is 00_Inbox really an inbox? How is 30_Research different from 40_Wiki? It used to guess — and a wrong guess means a misplaced note.'}</p>
      <p>{zh
        ? '现在它跑一句 deeporbit about，每个目录的语义、边界、使用约定都是结构化数据。schema v3 把这些写进 deeporbit.json——单一事实源，AI 直接读。'
        : 'Now it runs deeporbit about, and every directory\'s semantics, boundaries, and usage conventions come back as structured data. Schema v3 writes them into deeporbit.json — a single source of truth the AI can read directly.'}</p>
    </div>
    <div class="terminal" role="img" aria-label={zh ? 'deeporbit about inbox 的输出示例' : 'Sample output of deeporbit about inbox'}>
      <div class="terminal-bar">
        <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
        <span class="terminal-title">deeporbit about inbox</span>
      </div>
      <pre class="terminal-body"><code>$ deeporbit about inbox
{'{'}
  <span class="t-key">"logical_name"</span>: <span class="t-str">"inbox"</span>,
  <span class="t-key">"path"</span>: <span class="t-str">"00_Inbox"</span>,
  <span class="t-key">"title"</span>: <span class="t-str">"{zh ? '快速捕获' : 'Quick capture'}"</span>,
  <span class="t-key">"summary"</span>: <span class="t-str">"{zh ? '未经分类的想法、临时任务、待整理的剪藏' : 'Unfiled ideas, ad-hoc tasks, clipped references'}"</span>,
  <span class="t-key">"when_not"</span>: <span class="t-str">"{zh ? '已经明确归属的内容直接放到对应目录…' : 'Content with a clear home goes there directly…'}"</span>,
  <span class="t-key">"ai_notes"</span>: <span class="t-str">"{zh ? '添加任务用 deeporbit todo add…' : 'Add tasks with deeporbit todo add…'}"</span>
{'}'}</code></pre>
    </div>
  </div>
</section>

<!-- ============ Skills cloud ============ -->
<section class="container section">
  <div class="section-head">
    <div class="eyebrow">{zh ? 'Skills' : 'Skills'}</div>
    <div>
      <h2>{zh ? '33 个 do.* 技能，跑在这副骨架上。' : '33 do.* skills, running on this skeleton.'}</h2>
      <p class="section-intro">{zh
        ? '同一套技能，跨 5 个 Agent 运行时行为一致。技能负责工作流；骨架负责给 AI 一个可以读懂的世界。'
        : 'The same skills behave identically across five agent runtimes. Skills carry the workflows; the skeleton gives the AI a world it can read.'}</p>
    </div>
  </div>
  <div class="skills-cloud">
    {skills.map((s) => <code class="skill-pill">{s}</code>)}
  </div>
</section>

<!-- ============ Runtimes + growth loop ============ -->
<section class="well runtime-well">
  <div class="container section runtime-section">
    <div class="section-head">
      <div class="eyebrow">{zh ? '跨运行时' : 'Cross-runtime'}</div>
      <div>
        <h2>{zh ? '选择你的 Agent，而不是被 Agent 选择。' : 'Choose your agent. Do not be chosen by one.'}</h2>
        <p class="section-intro">{zh
          ? '同一套 skills/，同一份 Markdown。换一个运行时，只是换一扇窗。搭配 teach-me，每一次工作都会沉淀成学习者画像——系统越用越懂你。'
          : 'The same skills/ directory, the same Markdown. Switching runtimes is just switching windows. Pair it with teach-me, and every working session compounds into a learner profile — the system knows you better over time.'}</p>
      </div>
    </div>
    <ul class="runtime-badges" aria-label={zh ? '支持的运行时' : 'Supported runtimes'}>
      {runtimes.map((runtime) => <li class="badge"><span class="badge-dot" aria-hidden="true"></span>{runtime}</li>)}
    </ul>
  </div>
</section>

<!-- ============ Quickstart ============ -->
<section id="quickstart" class="container section">
  <div class="section-head">
    <div class="eyebrow">{zh ? '快速开始' : 'Quickstart'}</div>
    <div>
      <h2>{zh ? '三分钟，跑起来。' : 'Running in three minutes.'}</h2>
      <p class="section-intro">{zh ? '三条命令：装技能、初始化、打开仪表盘。之后的一切，都可以交给自然语言。' : 'Three commands: add the skills, initialize, open the dashboard. Everything after that is natural language.'}</p>
    </div>
  </div>
  <ol class="quickstart-list">
    {quickstart.map(([title, text, command], i) => (
      <li class="quickstart-step">
        <div class="step-head"><span class="step-num">0{i + 1}</span><div><h3>{title}</h3><p>{text}</p></div></div>
        <div class="step-cmd">
          <pre><code>{command}</code></pre>
          <button class="copy-btn" type="button" data-copy={command} aria-label={zh ? '复制命令' : 'Copy command'}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            <span class="copy-label">{zh ? '复制' : 'Copy'}</span>
          </button>
        </div>
      </li>
    ))}
  </ol>
  <p class="copy-status" aria-live="polite"></p>
</section>

<!-- ============ CTA ============ -->
<section class="cta container">
  <div>
    <div class="eyebrow">{zh ? '现在开始' : 'Start now'}</div>
    <h2>{zh ? '从今天的 Inbox 开始。' : 'Start with today’s Inbox.'}</h2>
  </div>
  <div>
    <p>{zh ? '三分钟安装、初始化，并创建第一条可检索的任务。之后，它会随你的研究与项目一起生长。' : 'Install, initialize, and capture your first retrievable task in three minutes. From there, it grows with your research and projects.'}</p>
    <div class="actions">
      <a class="button primary" href={`${home}docs/`}>{zh ? '阅读文档' : 'Read the docs'} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="button ghost" href="https://github.com/dull-bird/DeepOrbit">GitHub</a>
    </div>
  </div>
</section>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-block: clamp(64px, 10vh, 120px) var(--space-8);
    max-width: 860px;
  }
  .hero h1 {
    margin-top: var(--space-4);
    font-size: clamp(2.3rem, 4.4vw, 3.5rem);
    line-height: 1.28;
    word-break: keep-all;
  }
  .hero h1 .accent { color: var(--accent); }
  .hero-sub {
    max-width: 720px;
    margin: var(--space-5) 0 0;
    font-size: 1.08rem;
    line-height: 1.85;
  }
  .actions { display: flex; gap: 12px; margin-top: var(--space-6); flex-wrap: wrap; }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line);
  }
  .stat { padding: var(--space-5) var(--space-5) var(--space-5) 0; border-right: 1px solid var(--line); }
  .stat + .stat { padding-left: var(--space-5); }
  .stat:last-child { border-right: 0; }
  .stat-num {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label { color: var(--muted); font-size: 0.86rem; }

  /* ---------- shared section scaffolding ---------- */
  .section { padding-block: var(--space-9); }
  .section-head {
    display: grid;
    grid-template-columns: 0.62fr 1.38fr;
    gap: 32px;
    align-items: start;
    margin-bottom: var(--space-7);
  }

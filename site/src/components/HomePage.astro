<script is:inline define:vars={{ dirsData: DIRS, langNow: lang }}>
  const isZh = langNow === 'zh';
  const dirsByLogical = new Map(dirsData.map((d) => [d.logical, d]));
  const logicalOrder = dirsData.map((d) => d.logical);

  const elPath = document.getElementById('sk-path');
  const elLogical = document.getElementById('sk-logical');
  const elTitle = document.getElementById('sk-title');
  const elSummary = document.getElementById('sk-summary');
  const elWhenNot = document.getElementById('sk-when-not');
  const elAiNotes = document.getElementById('sk-ai-notes');
  const cycleBtn = document.getElementById('sk-cycle');
  const nodes = Array.from(document.querySelectorAll('.sk-node'));

  let currentLogical = 'inbox';

  function showDir(logical) {
    const dir = dirsByLogical.get(logical);
    if (!dir) return;
    currentLogical = logical;
    const copy = isZh ? dir.zh : dir.en;
    if (elPath) elPath.textContent = dir.path;
    if (elLogical) elLogical.textContent = dir.logical;
    if (elTitle) elTitle.textContent = copy.title;
    if (elSummary) elSummary.textContent = copy.summary;
    if (elWhenNot) elWhenNot.textContent = copy.when_not;
    if (elAiNotes) elAiNotes.textContent = copy.ai_notes;
    nodes.forEach((n) => {
      n.classList.toggle('is-active', n.getAttribute('data-logical') === logical);
    });
  }

  nodes.forEach((n) => {
    const logical = n.getAttribute('data-logical');
    if (!logical) return;
    n.addEventListener('mouseenter', () => showDir(logical));
    n.addEventListener('click', () => showDir(logical));
    n.addEventListener('focus', () => showDir(logical));
  });

  if (cycleBtn) {
    cycleBtn.addEventListener('click', () => {
      const idx = logicalOrder.indexOf(currentLogical);
      const next = logicalOrder[(idx + 1) % logicalOrder.length];
      showDir(next);
    });
  }

  showDir('inbox');
</script>

<script>
  const status = document.querySelector('.copy-status');
  document.querySelectorAll('.copy-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const zh = document.documentElement.lang === 'zh';
      const text = button.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        if (status) status.textContent = zh
          ? '浏览器未允许剪贴板访问，请直接选择并复制命令。'
          : 'Clipboard access is unavailable. Select and copy the command directly.';
        return;
      }
      const label = button.querySelector('.copy-label');
      const original = label?.textContent || '';
      if (label) label.textContent = zh ? '已复制' : 'Copied';
      if (status) status.textContent = zh ? '已复制到剪贴板。' : 'Copied to the clipboard.';
      window.setTimeout(() => { if (label) label.textContent = original; }, 1600);
    });
  });
</script>
